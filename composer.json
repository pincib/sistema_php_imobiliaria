{
    "name": "pinciara/crm-local-first",
    "description": "CRM Imobiliário Local-First",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "php bin/migrate.php",
        "create-admin": "php bin/create-admin.php",
        "backup": "php bin/backup.php",
        "restore": "php bin/restore.php",
        "test-restore": "php bin/test-restore.php",
        "health-check": "php bin/health-check.php",
        "test": "phpunit"
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true,
        "allow-plugins": {}
    }
}
