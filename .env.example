# Application Environment: development, staging, production
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost:8086
APP_TIMEZONE=America/Sao_Paulo

# 32-byte hex secret key for CSRF and application tokens
APP_SECRET=your-32-character-secret-key-change-this-in-production

# SQLite Database path (relative to project root or absolute)
DB_PATH=storage/database.sqlite

# Session settings
SESSION_LIFETIME=28800
SESSION_COOKIE_NAME=pinciara_session
SESSION_SECURE_COOKIE=false

# Backup and Retention Settings
BACKUP_DIR=storage/backups
BACKUP_KEEP_COUNT=14
BACKUP_RETENTION_DAYS=30
BACKUP_EXTERNAL_DIR=
